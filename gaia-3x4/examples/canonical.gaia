# dados sintéticos / duas origens, mesmos valores
dados = [
  6 8 8 8 7 5 3 2 1 2 3 5 7 8 9 9 7 6 4 4 4 5 6 6
  6 8 8 8 7 6 5 4 5 6 6 6 5 7 7 6 5 4 4 4 5 6 8 8
  5 6 5 4 3 2 2 3 6 8 9 9 5 5 4 2 1 0 1 4 7 8 8 7
  6 6 4 1 0 0 2 4 6 6 6 5 7 6 4 1 0 1 3 4 4 4 5 5
  8 7 4 2 2 3 4 4 4 5 5 2 7 6 4 3 4 6 5 6 7 6 3 1
  6 5 3 3 6 7 7 8 8 5 3 3 4 4 2 4 6 7 8 9 8 5 5 3
]
a = ⊙ "registro/A" "t0" "célula" "grade" [12 12] dados
b = ⊙ "registro/B" "t0" "célula" "grade" [12 12] dados
vinculo = ⇄ blend [0.35 2] b a
retrato fora corte = ⧉ 3:4 0.5 0.5 vinculo
antes = ↶ 1 retrato
anterior = ⋮ frame
amostra = ⊙ "arquivo/C" "t0" "célula" "grade" [1 1] [9]
perda = ⊘ "retirada explícita da amostra" amostra
◉ [retrato fora corte antes anterior perda a b vinculo]
